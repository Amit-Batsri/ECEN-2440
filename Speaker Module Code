from machine import Pin, PWM
from time import sleep_ms

SPEAKER_PIN = 18  # GPIO number; physical pin is 24
NOTES = ((523, 200), (659, 200), (784, 400))


def main():
    speaker = PWM(Pin(SPEAKER_PIN), freq=1000, duty_u16=0)
    try:
        print("Speaker test running on Pico GP18.")
        print("Expect 3 rising notes, then 3 seconds of silence.")
        print("Press Ctrl+C in the Pico terminal to stop.")

        while True:
            print("Playing tones...")
            for frequency, duration in NOTES:
                speaker.freq(frequency)
                speaker.duty_u16(32768)  # 50% square wave
                sleep_ms(duration)
                speaker.duty_u16(0)
                sleep_ms(100)
            sleep_ms(3000)

    except KeyboardInterrupt:
        print("Speaker test stopped.")
    finally:
        speaker.duty_u16(0)
        speaker.deinit()
        Pin(SPEAKER_PIN, Pin.OUT, value=0)


if __name__ == "__main__":
    main()
